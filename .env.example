# PentAGI Environment Variables - Simplified for DeepSeek

## DeepSeek LLM provider (REQUIRED)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_SERVER_URL=https://api.deepseek.com

## Embedding (uses DeepSeek by default)
EMBEDDING_PROVIDER=deepseek

## Agent execution settings (optional, use defaults if not set)
# MAX_GENERAL_AGENT_TOOL_CALLS=
# AGENT_PLANNING_STEP_ENABLED=

## Scraper settings (internal, managed by docker-compose)
SCRAPER_PRIVATE_URL=https://someuser:somepass@scraper/
LOCAL_SCRAPER_USERNAME=someuser
LOCAL_SCRAPER_PASSWORD=somepass

## PentAGI server settings (optional, use defaults)
# PENTAGI_DATA_DIR=
# PENTAGI_SSL_DIR=

## PentAGI security settings
PUBLIC_URL=https://localhost:8443
CORS_ORIGINS=https://localhost:8443
COOKIE_SIGNING_SALT=change-this-salt-for-security # IMPORTANT: Change this!

## PentAGI internal server settings
SERVER_PORT=8443
SERVER_HOST=0.0.0.0
SERVER_USE_SSL=true

## DuckDuckGo search engine (enabled by default)
DUCKDUCKGO_ENABLED=true

## Docker settings (managed by docker-compose)
DOCKER_INSIDE=true
DOCKER_NET_ADMIN=true
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_PUBLIC_IP=0.0.0.0

# Postgres (pgvector) settings - REQUIRED
PENTAGI_POSTGRES_USER=postgres
PENTAGI_POSTGRES_PASSWORD=change-this-postgres-password # IMPORTANT: Change this!
PENTAGI_POSTGRES_DB=pentagidb
